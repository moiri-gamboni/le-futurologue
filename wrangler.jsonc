{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "le-futurologue",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "assets": {
    "directory": ".svelte-kit/cloudflare",
    "binding": "ASSETS"
  },
  "compatibility_date": "2025-11-13",
  "compatibility_flags": ["nodejs_compat"]
}