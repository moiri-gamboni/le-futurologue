# Enforce engine compatibility from package.json
engine-strict=true
enable-pre-post-scripts=true

# Supply-chain cooldown: pnpm refuses to install any package version
# published less than 7 days ago. Mitigates freshly-malicious releases
# of dependencies (post-hijack, post-compromised-maintainer attacks).
# Units are minutes; 7 days = 10080. Supported since pnpm 10.
# To bypass for a targeted emergency upgrade, add the package to
# minimum-release-age-exclude or install with a specific version
# that has already passed the window.
minimum-release-age=10080